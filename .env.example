# local：本机单用户开发 / Electron；session：多用户或网络部署（生产环境必须使用 session）
APP_AUTH_MODE="local"

# session 模式必填：请使用至少 32 字符的随机值，绝不能使用示例值。
SESSION_SECRET="replace-with-a-long-random-session-secret"
# session/生产模式必填：用于 AES-256-GCM 的 API Key 加密，请使用随机强密钥。
ENCRYPTION_MASTER_KEY="replace-with-a-strong-random-encryption-secret"

# SQLite 默认：留空时应用使用 prisma/dev.db。PostgreSQL 部署时填写连接串。
DATABASE_URL=""
OLLAMA_BASE_URL="http://localhost:11434"

# 仅用于本机开发的环境级默认模型密钥。生产凭证请通过基础设置保存到加密数据库。
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
USD_CNY_RATE="7.25"
