# local：本机单用户开发 / Electron；session：多用户或网络部署（生产环境必须使用 session）
APP_AUTH_MODE="local"

# session 模式必填：请使用至少 32 字符的随机值，绝不能使用示例值。
SESSION_SECRET="replace-with-a-long-random-session-secret"
# session/生产模式必填：用于 AES-256-GCM 的 API Key 加密，请使用随机强密钥。
ENCRYPTION_MASTER_KEY="replace-with-a-strong-random-encryption-secret"

# SQLite 默认：留空时应用使用 prisma/dev.db。PostgreSQL 部署时填写连接串。
# 用 `npm run docker:up` 起本地 Postgres 后，可填：
#   postgresql://agentforge:agentforge@localhost:5432/agentforge?schema=public
DATABASE_URL=""
# Checkpoint 后端：留空/其他值走 SQLite（默认），设为 postgres 走 Postgres Checkpoint。
# 走 postgres 时复用上面的 DATABASE_URL 连接同一个库。
WORKFLOW_CHECKPOINT_BACKEND=""
# 生产默认不在应用实例启动时执行 Checkpoint DDL；部署阶段运行
# `npm run db:setup:workflow-checkpoints`。仅在受控环境确需自动初始化时设为 true。
WORKFLOW_CHECKPOINT_AUTO_SETUP=""
# 仅供 PostgreSQL 集成测试使用的专用数据库连接串，绝不能填写开发或生产数据库。
# 同时设置后可运行：npm run test:integration:postgres-checkpoint 与 npm run test:integration:postgres-workflow-lease
# 本地具备 Docker 时，优先使用 `npm run test:integration:postgres:local`；
# 该命令会临时启动 docker-compose 的 postgres-test 服务并自行注入这两个连接串。
AGENTFORGE_POSTGRES_CHECKPOINT_TEST_URL=""
AGENTFORGE_POSTGRES_WORKFLOW_TEST_URL=""
OLLAMA_BASE_URL="http://localhost:11434"
# Optional local hybrid RAG. Keep disabled until bge-m3 is pulled and existing documents are embedded.
RAG_EMBEDDINGS_ENABLED="false"
OLLAMA_EMBED_MODEL="bge-m3"
OLLAMA_EMBED_TIMEOUT_MS="60000"

# 仅用于本机开发的环境级默认模型密钥。生产凭证请通过基础设置保存到加密数据库。
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
USD_CNY_RATE="7.25"

# 消融实验仅在显式传入 --execute --confirm-external-costs 时读取以下配置并调用模型。
# 请锁定精确模型版本，并把原始输出写入不会提交的 local-only/ 目录。
LONGCAT_API_KEY=""
LONGCAT_BASE_URL=""
LONGCAT_MODEL=""
# Optional OpenTelemetry trace export. Leave unset for the default local no-op tracer.
# AGENTFORGE_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_SERVICE_NAME=agentforge
# AGENTFORGE_RELEASE_VERSION=2026.08.01
