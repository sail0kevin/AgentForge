{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "description": "Checkpointed multi-agent platform for requirement planning, cross-review, and traceable development reports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sail0kevin/AgentForge.git"
  },
  "homepage": "https://github.com/sail0kevin/AgentForge",
  "bugs": {
    "url": "https://github.com/sail0kevin/AgentForge/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/run-prisma-migrate.mjs",
    "db:migrate:sqlite": "node scripts/run-prisma-migrate.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:validate:postgres": "prisma validate --schema prisma/schema.postgres.prisma",
    "test:e2e": "node scripts/run-isolated-e2e.mjs",
    "test:e2e:core": "node scripts/run-isolated-e2e.mjs e2e/core.spec.ts",
    "test:e2e:session": "node scripts/run-isolated-e2e.mjs --auth-mode=session e2e/session-isolation.spec.ts",
    "test:unit": "tsx --test src/lib/*.test.ts src/lib/client/*.test.ts src/lib/engine/*.test.ts src/lib/engine/langgraph/*.test.ts src/lib/llm/*.test.ts src/lib/planner/*.test.ts src/lib/rag/*.test.ts src/lib/report/*.test.ts src/lib/review/*.test.ts src/lib/tools/*.test.ts src/lib/workflow/*.test.ts",
    "quality:blind:prepare": "tsx scripts/blind-evaluation.ts prepare",
    "quality:blind:analyze": "tsx scripts/blind-evaluation.ts analyze",
    "security:verify-secrets": "node scripts/verify-secret-hygiene.mjs",
    "migrate:legacy-keys": "node scripts/migrate-legacy-agent-keys.mjs --dry-run",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "edge-runtime": "^4.0.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.sail0kevin.agentforge",
    "productName": "AgentForge",
    "directories": {
      "output": "dist-electron"
    },
    "asar": false,
    "afterPack": "scripts/electron-after-pack.cjs",
    "npmRebuild": true,
    "files": [
      "electron/**/*",
      ".next/**/*",
      "prisma/migrations/**/*",
      "prisma/schema.prisma",
      "prisma/schema.postgres.prisma",
      "public/**/*",
      "node_modules/**/*",
      "next.config.ts",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/.prisma/**",
      "node_modules/@prisma/**",
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
