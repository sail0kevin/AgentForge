## ⚙️ 第三部分：后端核心服务实现 (Python)

### 3.1 统一大模型适配器 (`adapters/llm_adapter.py`)

适配器封装了不同 LLM 厂商的 API 差异，统一输出 Token 计数。

```python
import os
from typing import Dict, List, Any
from openai import OpenAI
from anthropic import Anthropic

class LLMAdapter:
    """多模型API适配器，支持流式与非流式调用"""
    
    @staticmethod
    def decrypt_key(encrypted_key: str) -> str:
        # TODO: 在此实现你的对称解密逻辑 (如使用 cryptography.fernet)
        return encrypted_key

    @classmethod
    def call_api(cls, agent_info: Dict[str, Any], history: List[Dict[str, Any]]) -> Dict[str, Any]:
        provider = agent_info["model_provider"]
        model_name = agent_info["model_name"]
        raw_key = cls.decrypt_key(agent_info["encrypted_api_key"])
        
        system_prompt = f"""
        你正在扮演一个特定角色。
        你的名字是: {agent_info['name']}
        角色人设与任务: {agent_info['system_prompt']}
        """

        # 1. 适配 OpenAI 格式的接口 (OpenAI, DeepSeek)
        if provider in ["openai", "deepseek"]:
            base_url = "https://api.deepseek.com" if provider == "deepseek" else None
            client = OpenAI(api_key=raw_key, base_url=base_url)
            
            messages = [{"role": "system", "content": system_prompt}]
            for msg in history:
                messages.append({
                    "role": "user" if msg["sender_type"] == "user" else "assistant",
                    "content": f"[{msg.get('sender_name', 'User')}]: {msg['content']}"
                })
                
            response = client.chat.completions.create(
                model=model_name,
                messages=messages,
                temperature=float(agent_info.get("temperature", 0.7)),
                max_tokens=int(agent_info.get("max_tokens", 2000))
            )
            
            return {
                "content": response.choices[0].message.content,
                "input_tokens": response.usage.prompt_tokens,
                "output_tokens": response.usage.completion_tokens
            }

        # 2. 适配 Anthropic 格式接口 (Claude)
        elif provider == "anthropic":
            client = Anthropic(api_key=raw_key)
            messages = []
            for msg in history:
                messages.append({
                    "role": "user" if msg["sender_type"] == "user" else "assistant",
                    "content": f"[{msg.get('sender_name', 'User')}]: {msg['content']}"
                })
                
            response = client.messages.create(
                model=model_name,
                max_tokens=int(agent_info.get("max_tokens", 2000)),
                temperature=float(agent_info.get("temperature", 0.7)),
                system=system_prompt,
                messages=messages
            )
            
            return {
                "content": response.content[0].text,
                "input_tokens": response.usage.input_tokens,
                "output_tokens": response.usage.output_tokens
            }
            
        raise ValueError(f"Unsupported provider: {provider}")
```

### 3.2 多 Agent 辩论与对话编排引擎 (`services/orchestrator.py`)

编排引擎控制发言顺序，捕捉 AI 之间的互动。

```python
from typing import Dict, Any, List
import decimal

class OrchestrationEngine:
    """控制多 Agent 发言流程、上下文加载与实时扣款"""
    
    def __init__(self, db_session):
        self.db = db_session

    def get_conversation_history(self, conv_id: str) -> List[Dict[str, Any]]:
        """获取结构化的历史记录，使 AI 能够清晰感知上下文是由谁发言"""
        sql = """
            SELECT sender_type, content, relation_type, reply_to_message_id,
                   u.email as user_email, a.name as agent_name
            FROM agent_messages m
            LEFT JOIN users u ON m.sender_user_id = u.id
            LEFT JOIN ai_agents a ON m.sender_agent_id = a.id
            WHERE conversation_id = :conv_id
            ORDER BY m.created_at ASC
        """
        results = self.db.execute(sql, {"conv_id": conv_id}).fetchall()
        
        history = []
        for r in results:
            history.append({
                "sender_type": r.sender_type,
                "sender_name": r.user_email if r.sender_type == "user" else r.agent_name,
                "content": r.content,
                "relation_type": r.relation_type,
                "reply_to_message_id": r.reply_to_message_id
            })
        return history

    def calculate_cost(self, model_name: str, input_tokens: int, output_tokens: int) -> Dict[str, decimal.Decimal]:
        """按实际价格表计费。此处以 1M token 为单位计算"""
        # 价格配置：每百万 Token 消耗的美元费用
        rates = {
            "claude-3-5-sonnet": {"in": 3.0, "out": 15.0},
            "gpt-4o": {"in": 2.5, "out": 10.0},
            "deepseek-chat": {"in": 0.27, "out": 1.1},
            "default": {"in": 1.0, "out": 3.0}
        }
        
        rate = rates.get(model_name, rates["default"])
        usd_in = decimal.Decimal(input_tokens) / decimal.Decimal(1000000) * decimal.Decimal(rate["in"])
        usd_out = decimal.Decimal(output_tokens) / decimal.Decimal(1000000) * decimal.Decimal(rate["out"])
        
        cost_usd = usd_in + usd_out
        exchange_rate = decimal.Decimal("7.25") -- 设定固定汇率或通过 API 实时查询
        
        return {
            "usd": cost_usd,
            "cny": cost_usd * exchange_rate
        }

    async def execute_debate_turn(self, workspace_id: str, conv_id: str, current_agent: Dict[str, Any]):
        """执行单回合的 AI 发言并计费扣款"""
        
        # 1. 预算熔断检查
        workspace = self.db.execute(
            "SELECT total_spent_cny, budget_limit_cny FROM workspaces WHERE id = :w_id FOR UPDATE",
            {"w_id": workspace_id}
        ).fetchone()
        
        if workspace.total_spent_cny >= workspace.budget_limit_cny:
            raise PermissionError("⚠️ 该工作区预算已被耗尽，讨论自动中止。")

        # 2. 准备上下文历史
        history = self.get_conversation_history(conv_id)
        
        # 3. 确定反驳对象（如果是辩论模式且已经存在历史发言，则反驳上一条发言）
        reply_to_id = None
        relation_type = None
        if len(history) > 1:
            last_msg_sql = """
                SELECT id, sender_type FROM agent_messages 
                WHERE conversation_id = :conv_id ORDER BY created_at DESC LIMIT 1
            """
            last_msg = self.db.execute(last_msg_sql, {"conv_id": conv_id}).fetchone()
            if last_msg:
                reply_to_id = last_msg.id
                relation_type = "rebut"  # 辩论模式下默认设置为反驳/论证

        # 4. 调用 API 适配器获取响应
        from adapters.llm_adapter import LLMAdapter
        result = LLMAdapter.call_api(current_agent, history)
        
        # 5. 写入消息表
        insert_msg_sql = """
            INSERT INTO agent_messages (conversation_id, sender_type, sender_agent_id, content, reply_to_message_id, relation_type)
            VALUES (:conv_id, 'agent', :agent_id, :content, :reply_id, :rel_type)
            RETURNING id
        """
        msg_id = self.db.execute(insert_msg_sql, {
            "conv_id": conv_id,
            "agent_id": current_agent["id"],
            "content": result["content"],
            "reply_id": reply_to_id,
            "rel_type": relation_type
        }).fetchone().id
        
        # 6. 计算费用并更新流水与工作区
        cost = self.calculate_cost(current_agent["model_name"], result["input_tokens"], result["output_tokens"])
        
        # 写入 Token 流水
        self.db.execute("""
            INSERT INTO token_usages (workspace_id, conversation_id, message_id, agent_id, model_name, input_tokens, output_tokens, cost_usd, cost_cny)
            VALUES (:w_id, :conv_id, :msg_id, :agent_id, :model_name, :in, :out, :cost_usd, :cost_cny)
        """, {
            "w_id": workspace_id,
            "conv_id": conv_id,
            "msg_id": msg_id,
            "agent_id": current_agent["id"],
            "model_name": current_agent["model_name"],
            "in": result["input_tokens"],
            "out": result["output_tokens"],
            "cost_usd": cost["usd"],
            "cost_cny": cost["cny"]
        })
        
        # 累加工作区已消耗预算
        self.db.execute("""
            UPDATE workspaces 
            SET total_spent_cny = total_spent_cny + :cost_cny,
                budget_status = CASE WHEN (total_spent_cny + :cost_cny) >= budget_limit_cny THEN 'exhausted' ELSE 'normal' END
            WHERE id = :w_id
        """, {"cost_cny": cost["cny"], "w_id": workspace_id})
        
        self.db.commit()
        
        return {
            "message_id": msg_id,
            "content": result["content"],
            "cost_cny": float(cost["cny"])
        }
```

