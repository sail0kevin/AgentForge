## 🎨 第四部分：前端界面实现 (Next.js 14 / shadcn/ui)

### 4.1 全局 Zustand 状态库 (`store/useWorkspaceStore.ts`)

```typescript
import { create } from 'zustand';

interface Agent {
  id: string;
  name: string;
  avatar: string;
  model_name: string;
}

interface Message {
  id: string;
  sender_type: 'user' | 'agent';
  sender_name: string;
  content: string;
  relation_type?: string;
}

interface WorkspaceState {
  currentWorkspaceId: string | null;
  activeAgents: Agent[];
  messages: Message[];
  totalSpentCny: number;
  budgetLimitCny: number;
  isGenerating: boolean;
  setWorkspace: (id: string, budget: number, spent: number) => void;
  setMessages: (messages: Message[]) => void;
  addMessage: (message: Message) => void;
  updateBudget: (spent: number) => void;
  setGenerating: (status: boolean) => void;
}

export const useWorkspaceStore = create<WorkspaceState>((set) => ({
  currentWorkspaceId: null,
  activeAgents: [],
  messages: [],
  totalSpentCny: 0,
  budgetLimitCny: 10,
  isGenerating: false,
  setWorkspace: (id, budget, spent) => set({ currentWorkspaceId: id, budgetLimitCny: budget, totalSpentCny: spent }),
  setMessages: (messages) => set({ messages }),
  addMessage: (message) => set((state) => ({ messages: [...state.messages, message] })),
  updateBudget: (spent) => set((state) => ({ totalSpentCny: state.totalSpentCny + spent })),
  setGenerating: (status) => set({ isGenerating: status })
}));
```

