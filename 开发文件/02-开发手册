## 💾 第二部分：数据库物理模型设计 (SQL)

以下为 PostgreSQL 的完整 DDL 脚本。设计时已规避浮点数计算精度问题，并建立了必要的索引。

```sql
-- 启用 UUID 扩展
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- 1. 用户表
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 2. AI 角色配置表
CREATE TABLE ai_agents (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    avatar VARCHAR(50) DEFAULT '🤖',
    model_provider VARCHAR(50) NOT NULL,             -- 'openai', 'anthropic', 'deepseek', 'gemini'
    model_name VARCHAR(100) NOT NULL,                -- 'gpt-4o', 'claude-3-5-sonnet', etc.
    encrypted_api_key TEXT NOT NULL,                 -- 对称加密存储的 API Key
    system_prompt TEXT NOT NULL,
    temperature NUMERIC(3, 2) DEFAULT 0.70,
    max_tokens INTEGER DEFAULT 2000,
    skills JSONB DEFAULT '[]'::jsonb,                -- ['code_gen', 'rebuttal']
    mcp_servers JSONB DEFAULT '[]'::jsonb,           -- 保存绑定的本地/远程 MCP 服务配置
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 3. 工作区（项目）表
CREATE TABLE workspaces (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    name VARCHAR(150) NOT NULL,
    description TEXT,
    budget_limit_cny NUMERIC(12, 4) DEFAULT 10.0000, -- 工作区预算上限（元）
    total_spent_cny NUMERIC(12, 4) DEFAULT 0.0000,   -- 累计消耗（元）
    budget_status VARCHAR(20) DEFAULT 'normal',      -- 'normal', 'warning', 'exhausted'
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 4. 工作区-AI角色关联表 (多对多)
CREATE TABLE workspace_members (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    workspace_id UUID REFERENCES workspaces(id) ON DELETE CASCADE,
    agent_id UUID REFERENCES ai_agents(id) ON DELETE CASCADE,
    custom_order INTEGER DEFAULT 0,                  -- 轮流发言顺序
    is_active BOOLEAN DEFAULT true,                  -- 在该工作区是否启用
    joined_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(workspace_id, agent_id)
);

-- 5. 对话会话表
CREATE TABLE conversations (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    workspace_id UUID REFERENCES workspaces(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    mode VARCHAR(50) DEFAULT 'sequential',           -- 发言编排模式: 'sequential'(轮流), 'debate'(辩论)
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 6. 对话消息明细表
CREATE TABLE agent_messages (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    conversation_id UUID REFERENCES conversations(id) ON DELETE CASCADE,
    sender_type VARCHAR(20) NOT NULL,                -- 'user', 'agent'
    sender_user_id UUID REFERENCES users(id) ON DELETE SET NULL,
    sender_agent_id UUID REFERENCES ai_agents(id) ON DELETE SET NULL,
    content TEXT NOT NULL,
    reply_to_message_id UUID REFERENCES agent_messages(id) ON DELETE SET NULL, -- 被反驳或引用的消息ID
    relation_type VARCHAR(20),                       -- 'reply', 'rebut'(反驳), 'agree'
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 7. 精确 Token 计费流水表
CREATE TABLE token_usages (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    workspace_id UUID REFERENCES workspaces(id) ON DELETE CASCADE,
    conversation_id UUID REFERENCES conversations(id) ON DELETE CASCADE,
    message_id UUID REFERENCES agent_messages(id) ON DELETE CASCADE,
    agent_id UUID REFERENCES ai_agents(id) ON DELETE SET NULL,
    model_name VARCHAR(100) NOT NULL,
    input_tokens INTEGER NOT NULL,
    output_tokens INTEGER NOT NULL,
    cost_usd NUMERIC(16, 8) NOT NULL,                -- 美元精确成本
    cost_cny NUMERIC(16, 8) NOT NULL,                -- 折合人民币精确成本
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 创建索引以优化高频读取
CREATE INDEX idx_msg_conv_time ON agent_messages(conversation_id, created_at ASC);
CREATE INDEX idx_usage_workspace ON token_usages(workspace_id);
```

