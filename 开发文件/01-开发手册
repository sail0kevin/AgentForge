## 🗄️ 2. 数据库设计与 Prisma 配置

### 2.1 初始化 Prisma
```bash
npx prisma init
```
配置 `.env` 中的 `DATABASE_URL`。

### 2.2 Schema 设计 (`prisma/schema.prisma`)
严格按以下模型设计，确保多 AI 关联与计费追踪无误：

```prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  globalBudget Float       @default(10.0)
  apiKeys      ApiKey[]
  agents       Agent[]
  workspaces   Workspace[]
  createdAt    DateTime    @default(now())
}

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  provider    String   // "openai", "anthropic", "deepseek"
  apiKeyEnc   String   // AES 加密后的 Key
  isValid     Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Agent {
  id           String           @id @default(cuid())
  userId       String
  name         String
  avatar       String           @default("🤖")
  model        String           // "gpt-4o", "claude-3-5-sonnet"
  systemPrompt String           @db.Text
  temperature  Float            @default(0.7)
  config       Json             // { skills: [], mcp: [] }
  workspaces   WorkspaceAgent[]
  user         User             @relation(fields: [userId], references: [id])
  createdAt    DateTime         @default(now())
}

model Workspace {
  id          String           @id @default(cuid())
  userId      String
  name        String
  mode        String           @default("sequential") // sequential | debate
  budgetLimit Float            @default(1.0)
  status      String           @default("active")
  agents      WorkspaceAgent[]
  messages    Message[]
  user        User             @relation(fields: [userId], references: [id])
  createdAt   DateTime         @default(now())
}

model WorkspaceAgent {
  workspaceId String
  agentId     String
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  agent       Agent            @relation(fields: [agentId], references: [id])
  @@id([workspaceId, agentId])
}

model Message {
  id          String      @id @default(cuid())
  workspaceId String
  role        String      // "user" | "assistant" | "orchestrator"
  agentId     String?
  content     String      @db.Text
  replyToId   String?
  tokenUsage  TokenUsage?
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime    @default(now())
}

model TokenUsage {
  id            String   @id @default(cuid())
  messageId     String   @unique
  model         String
  inputTokens   Int
  outputTokens  Int
  costUsd       Float
  message       Message  @relation(fields: [messageId], references: [id])
  createdAt     DateTime @default(now())
}
```

执行同步：`npx prisma db push`

