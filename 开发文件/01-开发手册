## ⚙️ 4. 核心编排引擎

这是整个项目的灵魂。它负责控制多个 AI 的发言顺序、上下文构建和辩论逻辑。

### 4.1 引擎核心逻辑 (`src/lib/engine/orchestrator.ts`)

```typescript
import { prisma } from '@/lib/db';
import { callLLM } from '@/lib/llm/router';
import { ChatMessage } from '@/lib/llm/types';
import { calculateCost } from '@/lib/utils/billing';

interface RunParams {
  workspaceId: string;
  userInput: string;
}

export async function runWorkspaceDiscussion({ workspaceId, userInput }: RunParams) {
  // 1. 获取工作区配置与激活的 Agent (按顺序)
  const workspace = await prisma.workspace.findUnique({
    where: { id: workspaceId },
    include: {
      agents: { 
        where: { isActive: true }, 
        orderBy: { sortOrder: 'asc' }, 
        include: { agent: true } 
      },
    },
  });

  if (!workspace || workspace.agents.length === 0) throw new Error("工作区未配置AI角色");

  // 2. 存储用户消息
  const userMessage = await prisma.message.create({
    data: { workspaceId, role: 'user', content: userInput }
  });

  // 3. 获取历史上下文 (最近 10 条，防 Token 爆炸)
  const history = await prisma.message.findMany({
    where: { workspaceId },
    orderBy: { createdAt: 'desc' },
    take: 10,
    include: { agent: true }
  });
  history.reverse();

  let lastAssistantContent = "";

  // 4. 依次执行 Agent 发言
  for (const wa of workspace.agents) {
    const agent = wa.agent;

    // 构建上下文
    const contextMessages = buildContext(history, userInput, lastAssistantContent, workspace.mode);

    // 获取解密的 API Key (伪代码，需自行实现加解密逻辑)
    const apiKey = await getDecryptedApiKey(agent.userId, agent.model);
    if (!apiKey) throw new Error(`未找到 ${agent.model} 的 API Key`);

    // 调用大模型
    const response = await callLLM(agent.model, agent.systemPrompt, contextMessages, apiKey);

    // 计算费用
    const costUsd = calculateCost(agent.model, response.usage.inputTokens, response.usage.outputTokens);

    // 存入数据库
    const aiMessage = await prisma.message.create({
      data: {
        workspaceId,
        role: 'assistant',
        agentId: agent.id,
        content: response.content,
        tokenUsage: {
          create: {
            model: agent.model,
            inputTokens: response.usage.inputTokens,
            outputTokens: response.usage.outputTokens,
            costUsd
          }
        }
      }
    });

    // 更新最近一次发言，供下一个 AI 参考
    lastAssistantContent = response.content;
    history.push({ role: 'assistant', content: response.content, agent: agent } as any);

    // TODO: 通过 WebSocket/SSE 将 response.content 流式推送给前端
  }
}

function buildContext(history: any[], userInput: string, lastAssistantContent: string, mode: string): ChatMessage[] {
  const messages: ChatMessage[] = [];
  
  // 将历史对话转换格式
  for (const msg of history) {
    if (msg.role === 'user') {
      messages.push({ role: 'user', content: msg.content });
    } else if (msg.role === 'assistant' && msg.agent) {
      // 关键：包装其他 AI 的发言，防止当前 AI 产生身份混淆
      messages.push({
        role: 'user',
        content: `[工作区成员 ${msg.agent.name} 说道]: ${msg.content}`
      });
    }
  }

  // 注入当前用户输入
  messages.push({ role: 'user', content: userInput });

  // 辩论模式提示
  if (mode === 'debate' && lastAssistantContent) {
    messages.push({
      role: 'user',
      content: `请针对上一位成员的发言给出你的看法。如有不同意见，请直接指出并说明理由。`
    });
  }

  return messages;
}
```

