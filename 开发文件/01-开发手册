## 💰 5. 计费与成本控制

### 5.1 费用计算表 (`src/lib/utils/billing.ts`)
```typescript
const PRICING_USD_PER_MILLION = {
  'gpt-4o': { input: 2.5, output: 10.0 },
  'gpt-4o-mini': { input: 0.15, output: 0.6 },
  'claude-3-5-sonnet-20240620': { input: 3.0, output: 15.0 },
  'deepseek-chat': { input: 0.27, output: 1.10 },
  // 默认兜底价格
  'default': { input: 1.0, output: 3.0 }
};

export function calculateCost(model: string, inputTokens: number, outputTokens: number): number {
  const price = PRICING_USD_PER_MILLION[model] || PRICING_USD_PER_MILLION['default'];
  const cost = (inputTokens / 1_000_000 * price.input) + (outputTokens / 1_000_000 * price.output);
  return parseFloat(cost.toFixed(6));
}
```

### 5.2 预算熔断中间件逻辑
在执行 `callLLM` 之前，必须加入预算检查：
```typescript
async function checkBudget(workspaceId: string, workspaceLimit: number) {
  const usage = await prisma.tokenUsage.aggregate({
    where: { message: { workspaceId } },
    _sum: { costUsd: true }
  });
  if ((usage._sum.costUsd || 0) >= workspaceLimit) {
    throw new Error("⚠️ 预算超限！当前工作区消耗已达上限，请提高预算或重置工作区。");
  }
}
```

